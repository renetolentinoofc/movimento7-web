{
  "name": "movimento7-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/web",
    "packages/ui"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @movimento7/web",
    "build": "npm run build --workspace @movimento7/web",
    "e2e": "playwright test",
